# Copy this file to .env.local (Codespaces/local) - NEVER commit the real values.
# On Vercel, add these two under Project Settings > Environment Variables instead.

# Neon connection string (Neon dashboard > Connect). Use a NEW Neon project/database just for this board.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxxxxx.region.aws.neon.tech/neondb?sslmode=require

# 32+ random characters. Generate one with:   openssl rand -base64 48
APP_SECRET=

# Optional: how many days a login lasts before asking for password + code again (default 7)
# SESSION_DAYS=7
